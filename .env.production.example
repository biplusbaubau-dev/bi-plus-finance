# ==========================================================
# Salin file ini menjadi .env.production lalu isi nilainya.
#   cp .env.production.example .env.production
# JANGAN commit .env.production ke git.
# ==========================================================

# --- Domain -------------------------------------------------
# Arahkan DNS A record domain ini ke IP VPS, lalu isi di sini.
# Untuk tes tanpa domain, pakai IP:  APP_DOMAIN=203.0.113.10
# (HTTPS otomatis tidak akan jalan dengan IP — lihat deploy/README.md)
APP_DOMAIN=finance.contoh.com

# --- Database -----------------------------------------------
POSTGRES_USER=biplus
POSTGRES_PASSWORD=GANTI_DENGAN_PASSWORD_PANJANG_ACAK_32_KARAKTER
POSTGRES_DB=bi_plus_finance

# --- Basic Auth ---------------------------------------------
# Username bebas. Password TIDAK ditulis di sini — isi BASIC_AUTH_HASH.
# Buat hash dengan:
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext 'PASSWORD_ANDA'
BASIC_AUTH_USER=biplus
BASIC_AUTH_HASH=$2a$14$GANTI_DENGAN_HASIL_CADDY_HASH_PASSWORD
